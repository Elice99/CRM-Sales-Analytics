	measure 'Active slicer label' = ```
			
			VAR slicer_filtered = [slicer is_filtered]
			
			VAR slicer_label =
			SWITCH(
			        SELECTEDVALUE('Slicer Table'[Slicer]),
			        "Account_tier", [List of account_tier values],
			        "Month", [List of Month values],
			        "Quarter", [List of Quarter values],
			        "Sector", [List of sector values],
			        "Location", [List of office_location values],
			        "Manager", [List of manager values],
			        "Sales_Agent", [List of sales_agent values],
			        "Series", [List of series values]
			)
			
			VAR show_slicer_label = 
			IF([slicer is_filtered] = 1, slicer_label)
			
			RETURN
			show_slicer_label
			```
		lineageTag: 0a15a4c9-2e58-4503-84bb-1e697800f8ca

	measure 'List of account_tier values' =
			
			VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('accounts'[account_tier])
			VAR __MAX_VALUES_TO_SHOW = 2
			RETURN
				IF(
					__DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,
					CONCATENATE(
						CONCATENATEX(
							TOPN(
								__MAX_VALUES_TO_SHOW,
								VALUES('accounts'[account_tier]),
								'accounts'[account_tier],
								ASC
							),
							'accounts'[account_tier],
							", ",
							'accounts'[account_tier],
							ASC
						),
						", etc."
					),
					CONCATENATEX(
						VALUES('accounts'[account_tier]),
						'accounts'[account_tier],
						", ",
						'accounts'[account_tier],
						ASC
					)
				)
		lineageTag: 9bba4505-0713-47a5-8184-3e3b997f3818

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
