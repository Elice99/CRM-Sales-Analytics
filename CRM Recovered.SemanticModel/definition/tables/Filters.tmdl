	measure 'active filter tooltip' = ```
			
			VAR month_ = IF(ISFILTERED(DateTable[Date].[Month]), "Month", BLANK())
			VAR quarter_ = IF(ISFILTERED(DateTable[Date].[Quarter]), "Quarter", BLANK())
			VAR manager = IF(ISFILTERED(sales_teams[manager]), "Manager", BLANK())
			VAR account_tier = IF(ISFILTERED(accounts[account_tier]), "Account Tier", BLANK())
			VAR Sector = IF(ISFILTERED(accounts[sector]), "Sector", BLANK())
			VAR series = IF(ISFILTERED(products[series]), "Product series", BLANK())
			VAR Agent = IF(ISFILTERED(sales_pipeline[sales_agent]), "Agent", BLANK())
			VAR Location = IF(ISFILTERED(accounts[office_location]), "Location", BLANK())
			// we would have to concat the var but concat reqiures a table which we will have to create using list{}
			
			VAR filter_list = 
			{month_, manager, account_tier, Sector, series, Agent}
			
			//because of the blank() our result will have alot of commas so we have to create a filter var to filter all the blank()
			
			VAR filter_table_ = FILTER(filter_list,[Value]<>BLANK())
			
			VAR filter_label_show =
			CONCATENATEX(filter_table_, [Value], ", ")
			
			RETURN "Active Filters:" & IF(filter_label_show<>BLANK(),filter_label_show, "None")
			```
		lineageTag: 72c30cc6-997a-4d21-958d-e8086c915380

	measure 'count active filters' =
			
			VAR account_tier = IF(ISFILTERED(accounts[account_tier]),1,0)
			VAR month_ = IF(ISFILTERED(DateTable[Date].[Month]),1,0)
			VAR quarter_ = IF(ISFILTERED(DateTable[Date].[Quarter]),1,0)
			VAR sector = IF(ISFILTERED(accounts[sector]),1,0)
			VAR location = IF(ISFILTERED(accounts[office_location]),1,0)
			VAR agent = IF(ISFILTERED(sales_pipeline[sales_agent]),1,0)
			VAR manager = IF(ISFILTERED(sales_teams[manager]),1,0)
			VAR Product_series = IF(ISFILTERED(products[series]),1,0)
			
			VAR filter_count = account_tier + month_ + quarter_+ sector + location + agent + manager + Product_series
			RETURN filter_count & ""
		lineageTag: a5ed715f-ac39-4ee0-954f-302308d8dde5

