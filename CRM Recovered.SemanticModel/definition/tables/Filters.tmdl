	measure 'slicer is_filtered' =
			
			SWITCH(
			    TRUE,
			        ISFILTERED(accounts[account_tier])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Account_tier",1,
			        ISFILTERED(DateTable[Date].[Month])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Month",1,
			        ISFILTERED(DateTable[Date].[Quarter])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Quarter",1,
			        ISFILTERED(accounts[sector])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Sector",1,
			        ISFILTERED(accounts[office_location])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Location",1,
			        ISFILTERED(sales_teams[manager])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Manager",1,
			        ISFILTERED(sales_pipeline[sales_agent])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Sales_Agent",1,
			        ISFILTERED(products[series])
			        && SELECTEDVALUE('Slicer Table'[Slicer])= "Series",1
			)
		formatString: 0
		lineageTag: baa7b30f-6b9f-4328-9b79-00b5f67051f3

