			VAR Qrt_Ranked = 
			    ADDCOLUMNS(
			        Qrt_Agent,
			        "Qrtly_rev_rate", RANKX(
			            Qrt_Agent,
			            'revenue measures'[total_revenue_closed]
			            , ,DESC,Dense
			        )
