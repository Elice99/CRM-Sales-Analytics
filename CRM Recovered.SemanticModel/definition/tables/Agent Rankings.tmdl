			    )
			RETURN
			    CONCATENATEX(TopQrtly_agent, 'sales_teams'[sales_agent], ", ")
			```
		lineageTag: c2b26990-baff-4d93-a19e-f2c5cdcdf930

	measure 'Qrt Agent_by_rev_rate' = ```
			
			VAR MaxDate = 
			    MAX(DateTable[Date])
			VAR currentQrt = 
			    CALCULATE(
			        MAX(DateTable[Date].[Quarter]),
			        FILTER(ALL('DateTable'), 'DateTable'[Date] = MaxDate)
			    )
			VAR Qrt_Agent = 
			    CALCULATETABLE(
			        VALUES('sales_teams'[sales_agent]),
